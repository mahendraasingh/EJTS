# VRPT Application Environment Variables

# Backend Config
PROJECT_NAME="Vulnerability Risk Prioritization Tool (VRPT)"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for local development, or PostgreSQL for production)
# Local SQLite:
DATABASE_URL="sqlite:///./vrpt.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://vrpt_user:vrpt_password@localhost:5432/vrpt_db"

# Threat Intelligence APIs (Optional API Key for higher rate limits)
NVD_API_KEY=""
FIRST_EPSS_API_URL="https://api.first.org/data/v1/epss"
CISA_KEV_API_URL="https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
