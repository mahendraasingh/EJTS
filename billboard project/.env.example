# Environment Configuration for Smart Billboard AI Analytics
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smart-billboard-insecure-dev-key-change-in-prod

# Server Config
HOST=127.0.0.1
PORT=5000

# Storage Paths
DATABASE_URL=sqlite:///instance/billboard.db
UPLOAD_FOLDER=media/advertisements

# Computer Vision / Camera Settings
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
INFERENCE_FPS=10
CONFIDENCE_THRESHOLD=0.45
YOLO_MODEL=yolov8n.pt

# Session & Tracking
LOST_TRACK_TIMEOUT=2.5
MIN_SESSION_DURATION=1.0
DEFAULT_AD_DURATION=10
